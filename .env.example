# ── Public endpoints (served by the shared Cloudflare tunnel) ──────────────
# CAP_URL is what share links are built from, so it must be the public origin —
# with localhost here, every link you send a client points at their own machine.
CAP_URL=https://screenshare.rocstarrmedia.com
S3_PUBLIC_URL=https://screenshare-media.rocstarrmedia.com

# ── Local ports ───────────────────────────────────────────────────────────
CAP_PORT=3003
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Access control ────────────────────────────────────────────────────────
# Passwordless owner access, applied ONLY to requests whose Host is local.
# Tunnelled traffic never qualifies and must pass Cloudflare Access instead.
SCREENSHARE_DISABLE_AUTH=true
# Extra hostnames that should count as local (comma separated), e.g. a LAN name.
SCREENSHARE_LOCAL_HOSTS=
# The Access identity that maps onto the owner account rather than a team-member
# account, so the library is the same whether you come in locally or publicly.
SCREENSHARE_OWNER_EMAIL=you@example.com

# Zero Trust team domain (e.g. rocstarrmedia or rocstarrmedia.cloudflareaccess.com)
# and the Application Audience tag of the Access application protecting
# screenshare.rocstarrmedia.com. Until both are set, the public URL will not sign
# anyone in — the dashboard stays closed while /s/ share links keep working.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=

# ── Sign-in email (optional) ──────────────────────────────────────────────
# Without BOTH of these the app cannot email sign-in codes and writes them to the
# server log instead (the sign-in page says so). RESEND_FROM_DOMAIN must be a
# domain verified in Resend; codes are sent from auth@<that domain>.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=

# ── Transcription and AI (optional) ───────────────────────────────────────
# Transcripts and searchable captions:
DEEPGRAM_API_KEY=
# AI titles, summaries and chapters (any one of these):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
